# Server only. Never use VITE_ prefixes for secrets. Leave blank for demo.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# Verify current provider pricing before enabling live mode. Zero disables it.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_DAILY_CALL_LIMIT=10
AI_DAILY_USD_LIMIT=0.10
AI_USAGE_DIR=.runtime
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PORT=8787
# Build path; keep a separate subdirectory for the existing site.
APP_BASE=/study-os/
# Enable browser AI requests only when the private server is configured.
VITE_AI_API_ENABLED=false
# Isolated production server.ts. Approved model: DeepSeek V4.1 Flash.
# Remain disabled until durable Redis and owner sign-in are verified.
BKIT_AI_LIVE=false
AI_DAILY_KRW_LIMIT=1000
BKIT_OWNER_EMAIL=
BKIT_GOOGLE_CLIENT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
